{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog",
	"compatibility_date": "2026-11-01",
	// Worker スクリプトを持たず、Astro のビルド成果物を Workers Static Assets として配信する
	"assets": {
		"directory": "./dist",
		// /blog へのアクセスで blog.html を返す (build.format: "file" に対応)
		"html_handling": "auto-trailing-slash"
	}
}
