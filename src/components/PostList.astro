---
import { tags as tagLabels } from "../../site.config";
import { formatDate, type Post } from "../lib/posts";

type Props = {
	posts: Post[];
};

const { posts } = Astro.props;
---

<ul class="post-list">
	{
		posts.map((post, i) => (
			<li class="post-item" style={`--fade-delay: ${Math.min(i, 10) * 50}ms`}>
				<time datetime={post.data.published_at}>{formatDate(post.data.published_at)}</time>
				<h3>
					<a href={`/blog/${post.id}`}>{post.data.title}</a>
				</h3>
				<p>{post.data.description}</p>
				<div class="tags">
					{post.data.tags.map((tag) => (
						<a href={`/tags/${tag}`}>#{tagLabels[tag]}</a>
					))}
				</div>
			</li>
		))
	}
</ul>

<style>
	/* ページ幅を活かしてカードを複数列に並べる (1 枚が 320px を下回らない範囲で列を増やす) */
	.post-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
		gap: 1.25rem;
		list-style: none;
	}

	.post-item {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--border-color);
		border-radius: 12px;
		background: var(--bg-secondary);
		transition:
			border-color var(--transition-fast),
			background-color var(--transition-fast),
			box-shadow var(--transition-fast);
		animation: fade-in-up 0.4s ease var(--fade-delay, 0s) both;
	}

	.post-item:hover {
		border-color: var(--color-primary);
		box-shadow: var(--shadow-md);
	}

	@keyframes fade-in-up {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}

	time {
		color: var(--text-tertiary);
		font-size: 0.8125rem;
	}

	h3 {
		margin: 0.375rem 0 0.5rem;
		font-size: 1.125rem;
	}

	h3 a {
		color: var(--text-primary);
	}

	/* カード全体をクリックできるようにする (タグのリンクは上に重ねる) */
	h3 a::after {
		position: absolute;
		inset: 0;
		content: "";
	}

	.post-item:hover h3 a {
		color: var(--color-link);
	}

	p {
		font-size: 0.875rem;
	}

	/* 説明の長さが違ってもタグの位置をカードの下端に揃える */
	.tags {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.75rem;
		margin-top: auto;
		padding-top: 0.875rem;
		font-size: 0.8125rem;
	}

	.tags a:hover {
		text-decoration: underline;
	}

	@media (prefers-reduced-motion: reduce) {
		.post-item {
			animation: none;
		}
	}
</style>
