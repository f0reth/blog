---
import { createHash } from "node:crypto";
import { SiteConfig } from "../../site.config";
import { publicPath } from "../lib/url";
import themeScript from "../scripts/theme.js?raw";

type Props = {
	title?: string;
	desc?: string;
	slug?: string;
};

const { title, desc, slug } = Astro.props;

const pageTitle = title ? `${title} - ${SiteConfig.blogName}` : SiteConfig.blogName;
const description = desc ?? SiteConfig.description;
const pageUrl = new URL(publicPath(Astro.url.pathname), SiteConfig.url).href;
const ogImage = new URL(slug ? `ogps/${slug}.png` : "ogp.png", SiteConfig.url).href;

// インラインのテーマ切替スクリプトを CSP で許可するためにハッシュを登録する
const themeScriptHash = createHash("sha256").update(themeScript).digest("base64");
Astro.csp?.insertScriptHash(`sha256-${themeScriptHash}`);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="color-scheme" content="light dark" />
<!-- 独自のダークテーマを持つため、Dark Reader による色の上書きを止める -->
<meta name="darkreader-lock" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta property="og:url" content={pageUrl} />
<meta property="og:type" content={slug ? "article" : "website"} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SiteConfig.blogName} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@f0reth" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" type="application/rss+xml" title={`${SiteConfig.blogName}のブログ`} href="/feed.xml" />
<script is:inline set:html={themeScript} />
