---
import { SiteConfig } from "../../site.config";

const year = new Date().getFullYear();
---

<footer class="capsule-footer">
	<div class="footer-inner">
		<p class="footer-text">&copy; {year} {SiteConfig.blogName}</p>
		<div class="footer-links">
			<a href="https://x.com/f0reth" target="_blank" rel="noreferrer" aria-label="X">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path>
				</svg>
			</a>
			<a href="https://github.com/f0reth" target="_blank" rel="noreferrer" aria-label="GitHub">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
				</svg>
			</a>
			<a href="/feed.xml" aria-label="RSS">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
					<path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1.2" fill="currentColor"></circle>
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	.capsule-footer {
		width: min(100% - 2 * var(--page-gutter), var(--page-width));
		margin: 4rem auto 0;
		padding-bottom: 2rem;
		view-transition-name: footer;
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 1.25rem;
		border: 1px solid var(--nav-border);
		border-radius: 9999px;
		background: var(--nav-bg);
		backdrop-filter: var(--backdrop);
		box-shadow: var(--shadow-sm);
	}

	.footer-text {
		color: var(--text-tertiary);
		font-size: 0.8125rem;
		white-space: nowrap;
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 0.875rem;
	}

	.footer-links a {
		display: grid;
		place-items: center;
		color: var(--text-tertiary);
	}

	.footer-links a:hover {
		color: var(--color-primary);
	}

	/* スマホでは FloatingMenu と重ならないよう下に余白を取る */
	@media (width <= 640px) {
		.capsule-footer {
			padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
		}
	}
</style>
