<dialog class="search-modal" aria-label="記事を検索">
	<div class="panel">
		<div class="input-wrapper">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<circle cx="11" cy="11" r="8"></circle>
				<path d="M21 21l-4.35-4.35"></path>
			</svg>
			<input
				class="search-input"
				type="search"
				placeholder="タイトル・説明・タグで検索…"
				autocomplete="off"
				role="combobox"
				aria-expanded="true"
				aria-controls="search-results"
				aria-autocomplete="list"
			/>
			<kbd class="kbd">ESC</kbd>
		</div>
		<div class="results" id="search-results" role="listbox" aria-label="検索結果"></div>
		<div class="foot" aria-hidden="true">
			<span><kbd class="kbd">↑</kbd> <kbd class="kbd">↓</kbd> 選択</span>
			<span><kbd class="kbd">Enter</kbd> 開く</span>
			<span><kbd class="kbd">ESC</kbd> 閉じる</span>
		</div>
	</div>
</dialog>

<style>
	.search-modal {
		width: calc(100% - 2rem);
		max-width: 560px;
		max-height: none;
		margin: 10vh auto auto;
		border: 0;
		background: none;
		color: inherit;
		opacity: 0;
		transform: scale(0.96);
		transition:
			opacity var(--transition-normal),
			transform var(--transition-normal),
			overlay var(--transition-normal) allow-discrete,
			display var(--transition-normal) allow-discrete;
	}

	.search-modal[open] {
		opacity: 1;
		transform: none;
	}

	@starting-style {
		.search-modal[open] {
			opacity: 0;
			transform: scale(0.96);
		}
	}

	.search-modal::backdrop {
		background: rgb(36 45 51 / 0.4);
		backdrop-filter: blur(2px);
	}

	.panel {
		overflow: hidden;
		border: 1px solid var(--border-color);
		border-radius: 16px;
		background: var(--bg-primary);
		box-shadow: var(--shadow-lg);
	}

	.input-wrapper {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem 1.25rem;
		border-bottom: 1px solid var(--border-color);
		color: var(--text-tertiary);
	}

	.search-input {
		flex: 1;
		min-width: 0;
		border: 0;
		outline: 0;
		background: none;
		color: var(--text-primary);
		font: inherit;
		font-size: 1rem;
	}

	.search-input::placeholder {
		color: var(--text-tertiary);
	}

	.results {
		max-height: min(400px, 60vh);
		overflow-y: auto;
		padding: 0.5rem;
	}

	.results :global(.empty) {
		padding: 2rem;
		color: var(--text-tertiary);
		font-size: 0.875rem;
		text-align: center;
	}

	.results :global(.label) {
		padding: 0.5rem 1rem 0.25rem;
		color: var(--text-tertiary);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.results :global(.result) {
		display: block;
		padding: 0.75rem 1rem;
		border-radius: 10px;
		transition: background var(--transition-fast);
	}

	.results :global(.result:hover),
	.results :global(.result[aria-selected="true"]) {
		background: var(--bg-secondary);
	}

	.results :global(.result[aria-selected="true"]) {
		box-shadow: inset 2px 0 var(--color-primary);
	}

	.results :global(.result-title) {
		margin-bottom: 0.125rem;
		color: var(--text-primary);
		font-size: 0.9375rem;
		font-weight: 600;
	}

	.results :global(.result-description) {
		display: -webkit-box;
		overflow: hidden;
		margin-bottom: 0.375rem;
		font-size: 0.8125rem;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.results :global(.result-meta) {
		display: flex;
		gap: 0.75rem;
		color: var(--text-tertiary);
		font-size: 0.75rem;
	}

	.results :global(.result-tags) {
		color: var(--color-link);
	}

	.results :global(mark) {
		border-radius: 2px;
		background: var(--selection);
		color: inherit;
	}

	.foot {
		display: flex;
		gap: 1rem;
		padding: 0.625rem 1.25rem;
		border-top: 1px solid var(--border-color);
		color: var(--text-tertiary);
		font-size: 0.75rem;
	}

	@media (width <= 640px) {
		.foot {
			display: none;
		}
	}
</style>

<script>
	import { setupSearchModal } from "../scripts/search";

	setupSearchModal();
</script>
