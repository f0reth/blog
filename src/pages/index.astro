---
import { SiteConfig } from "../../site.config";
import PostList from "../components/PostList.astro";
import Layout from "../layouts/Layout.astro";
import { getPosts } from "../lib/posts";

const posts = await getPosts();
---

<Layout>
	<div class="container">
		<section class="hero">
			<h1>{SiteConfig.blogName}</h1>
			<p>{SiteConfig.description}</p>
		</section>
		<section>
			<h2>最新の記事 <small>{posts.length} 件</small></h2>
			<PostList posts={posts} />
		</section>
	</div>
</Layout>

<style>
	.hero {
		padding: 3rem 0 2.5rem;
		text-align: center;
	}

	.hero h1 {
		margin-bottom: 0.75rem;
		background: linear-gradient(135deg, var(--color-primary), var(--color-link) 55%, #807aff);
		background-clip: text;
		color: transparent;
		font-size: 3.25rem;
		letter-spacing: -0.02em;
	}

	.hero p {
		max-width: 520px;
		margin: 0 auto;
		font-size: 1.125rem;
	}

	h2 {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin: 1.5rem 0;
		font-size: 1.5rem;
	}

	small {
		color: var(--text-tertiary);
		font-size: 0.875rem;
		font-weight: 500;
	}

	@media (width <= 640px) {
		.hero {
			padding: 2rem 0 1.5rem;
		}

		.hero h1 {
			font-size: 2.5rem;
		}

		.hero p {
			font-size: 1rem;
		}
	}
</style>
